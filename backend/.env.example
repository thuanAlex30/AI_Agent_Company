PORT=3000
DATABASE_PATH=../data/bizops.db
JWT_SECRET=thay-bang-chuoi-ngau-nhien-32-ky-tu-o-prod
NODE_ENV=development
# CORS: ERP noi bo + storefront public (prod thay bang domain that)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
STOREFRONT_URL=http://localhost:5174
AGENT_URL=http://localhost:3100
AGENT_INTERNAL_KEY=dev-agent-key
AGENT_PUBLIC_KEY=dev-agent-key
REMINDER_CRON=0 8 * * *
COMPANY_NAME=BizOps Cafe
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BRIEF_LOG=../logs
# VietQR tinh (P1 doc, P3 webhook se dung WEBHOOK_SECRET)
# VIETQR_ACCOUNT=
# WEBHOOK_SECRET=
# Postgres prod (bo trong la dung SQLite):
# PG_HOST= PG_PORT=5432 PG_USER= PG_PASSWORD= PG_DB=

# ---------------------------------------------------------------------------
# Phase 6 (OPS-05) — bien moi truong van hanh.
# ---------------------------------------------------------------------------
# TRUST_PROXY: so hop proxy tin duoc.
#   - nginx CUNG host (docker-compose)      => loopback
#   - nginx tren may khac (1 hop)            => 1
#   - cloudflare + nginx (2 hop)             => 2
# KHONG dat "true"/1 neu co nhieu proxy — se cho phep gia IP trong rate-limit.
TRUST_PROXY=loopback
# COOKIE_SAMESITE: lax (SPA cung-site) | strict | none (cross-site, can Secure)
COOKIE_SAMESITE=lax
# CSRF_ENABLED: 1 = bat csrfGuard cho mutation (prod BAT BUOC bat)
CSRF_ENABLED=1
# ACCESS_TTL: thoi han access token (30m = chuan enterprise)
ACCESS_TTL=30m
# REFRESH_DAYS: so ngay refresh token hop le
REFRESH_DAYS=7
# MAX_SESSIONS_PER_USER: so phien dong thoi toi da cho 1 user
MAX_SESSIONS_PER_USER=5
# APP_VERSION: hien thi tren UI (doc tu /api/health)
APP_VERSION=11.1.0
# LOG_DIR: thu muc ghi log (can writable neu container read_only)
LOG_DIR=./logs
