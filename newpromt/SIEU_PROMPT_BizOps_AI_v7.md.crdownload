## PHỤ LỤC B — Mẫu mã cho các sửa chữa chính

> Mẫu minh họa ý tưởng, cần điều chỉnh theo codebase và kiểm thử trước khi dùng.

**B1 · Cấu hình fail-fast (SEC-02)**
```js
// backend/src/config.js  (agent_svc dùng bản tương tự)
const prod = process.env.NODE_ENV === 'production';
const FORBIDDEN = new Set(['', 'dev-agent-key', 'changeme']);

function secret(name) {
  const v = process.env[name] || '';
  if (prod && (FORBIDDEN.has(v) || v.length < 32)) {
    throw new Error(`[config] ${name} thiếu hoặc yếu: cần ≥ 32 ký tự, không dùng giá trị mặc định`);
  }
  return v || `dev-only-${name.toLowerCase()}`;
}

const cfg = {
  AGENT_INTERNAL_KEY: secret('AGENT_INTERNAL_KEY'),
  AGENT_PUBLIC_KEY: secret('AGENT_PUBLIC_KEY'),   // KHÔNG fall back sang INTERNAL
  JWT_SECRET: secret('JWT_SECRET'),
  WEBHOOK_SECRET: secret('WEBHOOK_SECRET'),
};
if (prod && cfg.AGENT_INTERNAL_KEY === cfg.AGENT_PUBLIC_KEY) {
  throw new Error('[config] AGENT_INTERNAL_KEY và AGENT_PUBLIC_KEY phải khác nhau');
}
module.exports = cfg;
```
```yaml
# docker-compose.yml — bỏ giá trị mặc định, bỏ publish cổng agent
agent:
  environment:
    - AGENT_INTERNAL_KEY=${AGENT_INTERNAL_KEY:?bắt buộc}
    - AGENT_PUBLIC_KEY=${AGENT_PUBLIC_KEY:?bắt buộc}
  expose: ["3100"]        # thay cho ports: "3100:3100"
```

**B2 · Cập nhật thanh toán nguyên tử (DB-02)**
```js
// Mọi vế phải trong SET dùng giá trị CŨ của hàng (đúng ở cả SQLite và PostgreSQL)
const r = await c.run(
  `UPDATE debts
      SET paid   = paid + ?,
          status = CASE WHEN paid + ? >= amount THEN 'done' ELSE status END
    WHERE id = ? AND paid + ? >= 0 AND paid + ? <= amount`,
  [amount, amount, debtId, amount, amount]
);
if (r.changes === 0) {
  throw new AppError('CONFLICT', 'Vượt số còn lại hoặc công nợ không tồn tại', 409);
}
```

**B3 · Khóa theo SKU khi kiểm tồn trên PostgreSQL (DB-02)**
```js
// Trong tx, trước khi đọc SUM(stock_moves) và chèn bút toán xuất kho
if (DIALECT === 'pg') {
  await c.run('SELECT pg_advisory_xact_lock(hashtext(?))', [sku]);
}
const onhand = (await c.get('SELECT COALESCE(SUM(qty),0) s FROM stock_moves WHERE product_sku=?', [sku])).s;
```

**B4 · Webhook ký trên byte thô (PAY-01)**
```js
// server.js — mount TRƯỚC express.json()
app.use('/api/public/payments/webhook', express.raw({ type: '*/*', limit: '100kb' }));

// handler (lược đồ ký cụ thể phải theo tài liệu của nhà cung cấp)
const ts = String(req.headers['x-timestamp'] || '');
if (!ts || Math.abs(Date.now() - Number(ts) * 1000) > 5 * 60 * 1000) return res.status(401).end();
const expected = crypto.createHmac('sha256', secret).update(`${ts}.`).update(req.body).digest();
const given = Buffer.from(String(req.headers['x-signature'] || ''), 'hex');
if (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return res.status(401).end();
const payload = JSON.parse(req.body.toString('utf8'));   // chỉ parse SAU khi xác thực
```

**B5 · BM25 bằng SQLite FTS5 (AI-01)**
```sql
CREATE VIRTUAL TABLE IF NOT EXISTS kb_fts USING fts5(
  title, body, source UNINDEXED,
  tokenize = 'unicode61 remove_diacritics 2'
);
-- Nạp văn bản đã qua norm() (xử lý cả đ→d): INSERT INTO kb_fts VALUES (norm(t), norm(b), src)
-- Truy vấn: bm25() càng NHỎ (âm hơn) càng khớp
SELECT source, title, bm25(kb_fts) AS score
  FROM kb_fts WHERE kb_fts MATCH ? ORDER BY score LIMIT 5;
```
PostgreSQL tương đương: `to_tsvector('simple', unaccent(body))` + chỉ mục GIN + `ts_rank_cd`.

**B6 · Truyền mốc thời gian từ ứng dụng (DB-01, OPS-02)**
```js
// Một nguồn thời gian duy nhất, đa phương ngữ, kiểm thử được
const sinceVN = (days) => /* ngày nghiệp vụ VN trừ `days`, định dạng YYYY-MM-DD, dùng thư viện múi giờ */;
const rev = await c.get(
  "SELECT COALESCE(SUM(amount),0) s FROM orders WHERE order_date >= ? AND status NOT IN ('cancelled','refunded','draft')",
  [sinceVN(30)]
);
```

**B7 · Khung test đồng thời (DB-02)** — `placeOrder`, `onHand` là hàm giả định, viết theo test hiện có
```js
test('20 đơn song song, tồn 5 → đúng 5 thành công', async () => {
  const rs = await Promise.allSettled(
    Array.from({ length: 20 }, (_, i) => placeOrder({ sku: 'CF-SUA-01', qty: 1, idem: `k${i}` }))
  );
  assert.equal(rs.filter(r => r.status === 'fulfilled').length, 5);
  assert.equal(await onHand('CF-SUA-01'), 0);
});
```

**B8 · Lint chống SQL đặc thù SQLite (thêm vào `verify.js`, DB-01)**
```js
const FORBIDDEN = [/datetime\(/i, /date\('now'/i, /strftime\(/i, /INSERT\s+OR\s+(IGNORE|REPLACE)/i, /AUTOINCREMENT/i];
// quét mọi *.js dưới backend/src và agent_svc/src, trừ common/db.js và migrations SQLite
// vi phạm → in tệp:dòng và exit(1)
```

**B9 · Test SEC-01 (mẫu)**
```js
const VARIANTS = [
  'công nợ của tôi 0912345678', 'cong no cua toi 0912345678', 'xem nợ giúp tôi 0912 345 678',
  'tôi còn nợ bao nhiêu? sdt +84912345678', 'kiểm tra dư nợ đơn của tôi: 09-12-34-56-78',
  /* ... ≥ 20 biến thể, gồm cả gửi qua trường `contact` và hội thoại nhiều lượt ... */
];
for (const msg of VARIANTS) {
  const r = await publicChat({ message: msg });
  assert.ok(!/\d[\d.,]{3,}\s*(đ|vnd|vnđ)/i.test(r.reply), `Lộ số tiền: ${msg}`);
  assert.ok(!['debt'].includes(r.intent));
}
```

